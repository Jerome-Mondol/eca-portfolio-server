# Neon Postgres — pooled URL from Neon dashboard (include ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Upstash Redis — from Upstash dashboard
# Either REDIS_URL (rediss://default:xxx@xxx.upstash.io:6379) or UPSTASH_REDIS_URL
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST:6379

# Alternative Upstash REST (if using @upstash/redis later)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

JWT_ACCESS_SECRET=change-me-to-32+chars-access-secret
JWT_REFRESH_SECRET=change-me-to-32+chars-refresh-secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

CLIENT_URL=http://localhost:3000
PORT=4000
NODE_ENV=development

# Cloudflare R2 — profile images + universal uploads
# Get these from Cloudflare dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=folio-uploads
R2_PUBLIC_URL=https://your-bucket.your-account.r2.dev
# Optional: custom endpoint (default: https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# AI — certificate extraction + research (get a free key at aistudio.google.com)
# Free tier: no credit card, ~1500 req/day, ~500/day with Google Search grounding.
# PRIVACY: on the free tier Google may use submitted images/text to improve its models.
# The paid tier does not. Only the issuing organization name is sent, never the
# student's name — but switch to a paid key before onboarding real users.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
